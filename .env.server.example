# Template for server / CI: copy to .env and fill values (see repo secrets for GitHub Actions).
# Compose file: compose.local.yml (direct ports, no Traefik).

ENVIRONMENT=staging
DOMAIN=localhost
PROJECT_NAME=Saree ERP

# Docker image names (local tags from compose build)
DOCKER_IMAGE_BACKEND=saree-backend
DOCKER_IMAGE_FRONTEND=saree-frontend
TAG=latest

# Secrets (use repo Secrets in CI; strong values on real servers)
SECRET_KEY=changethis
POSTGRES_PASSWORD=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Database (POSTGRES_SERVER is overridden to db inside compose)
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=saree-erp-project
POSTGRES_USER=saree

# Browser-facing URLs (must match FRONTEND_PORT / BACKEND_PORT on the host)
FRONTEND_HOST=http://localhost:3000
BACKEND_CORS_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8100
VITE_API_URL=http://localhost:8100

# Optional email
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=

# Optional monitoring
SENTRY_DSN=

# Host port mapping (also set in workflow env; defaults in compose if unset)
# FRONTEND_PORT=3000
# BACKEND_PORT=8100
# ADMINER_PORT=8282
